    "Uses any OpenAI-compatible chat-completions endpoint. Default is Hack Club AI — free API keys for students at ai.hackclub.com.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل مع أي خدمة محادثة متوافقة مع OpenAI. الخيار الافتراضي هو Hack Club AI، مع مفاتيح API مجانية للطلاب على ai.hackclub.com."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses any OpenAI-compatible chat-completions endpoint. Default is Hack Club AI — free API keys for students at ai.hackclub.com."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona con cualquier servicio de chat compatible con OpenAI. El predeterminado es Hack Club AI: claves de API gratis para estudiantes en ai.hackclub.com."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी OpenAI-संगत चैट-कम्प्लीशन एंडपॉइंट के साथ काम करता है। डिफ़ॉल्ट Hack Club AI है — छात्रों के लिए ai.hackclub.com पर मुफ़्त API कुंजियाँ।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可使用任何兼容 OpenAI 的对话补全端点。默认使用 Hack Club AI——学生可在 ai.hackclub.com 免费获取 API 密钥。"
          }
        }
      }
    },
