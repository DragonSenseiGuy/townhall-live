  "strings": {
    "%@ Meeting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اجتماع %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Meeting"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reunión de %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की बैठक"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@会议"
          }
        }
      }
    },
    "A no vote rejects the article as written.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصويت بلا يرفض البند بصيغته المكتوبة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A no vote rejects the article as written."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voto en contra rechaza el artículo tal como está redactado."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विपक्ष में वोट अनुच्छेद को लिखे रूप में अस्वीकार करता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投反对票即否决该条款原文。"
          }
        }
      }
    },
    "A yes vote approves the article as written in the warrant.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصويت بنعم يوافق على البند كما ورد في جدول الأعمال."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A yes vote approves the article as written in the warrant."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un voto a favor aprueba el artículo tal como está redactado en la convocatoria."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पक्ष में वोट अनुच्छेद को वारंट में लिखे अनुसार स्वीकृत करता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投赞成票即按议案原文批准该条款。"
          }
        }
      }
    },
    "AI disclosure: AI is used to write plain-English summaries of public warrant articles and to translate them at runtime, and was used to prepare the bundled summaries. All legal text remains sourced from public town documents.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إفصاح عن الذكاء الاصطناعي: يُستخدم الذكاء الاصطناعي لكتابة ملخصات بلغة بسيطة لبنود جدول الأعمال العامة وترجمتها أثناء استخدام التطبيق، كما استُخدم في إعداد الملخصات المضمّنة. جميع النصوص القانونية مأخوذة من وثائق البلدة العامة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI disclosure: AI is used to write plain-English summaries of public warrant articles and to translate them at runtime, and was used to prepare the bundled summaries. All legal text remains sourced from public town documents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso de IA: la IA se usa para redactar resúmenes en lenguaje sencillo de los artículos públicos de la convocatoria y para traducirlos mientras usas la app, y se usó para preparar los resúmenes incluidos. Todo el texto legal proviene de documentos públicos del municipio."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI प्रकटीकरण: ऐप चलते समय सार्वजनिक वारंट अनुच्छेदों के सरल भाषा सारांश लिखने और उनका अनुवाद करने के लिए AI का उपयोग करता है, और साथ आए सारांश तैयार करने में भी AI का उपयोग हुआ है। सारा कानूनी पाठ नगर के सार्वजनिक दस्तावेज़ों से ही लिया गया है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 使用说明：应用在运行时使用 AI 为公开的议案条款撰写通俗易懂的摘要并进行翻译，内置摘要的准备过程也使用了 AI。所有法律文本均来自镇政府的公开文件。"
          }
        }
      }
    },
